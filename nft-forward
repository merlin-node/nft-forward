#!/bin/bash
# nft-forward - nftables 中转管理脚本
# 适用系统: Debian 13

set -o pipefail

# ============ 路径配置 ============
CONF_DIR="/etc/nft-forward"
RULES_FILE="$CONF_DIR/rules.conf"
SETTINGS_FILE="$CONF_DIR/settings.conf"
NFT_FILE="/etc/nftables-forward.conf"
LOG_FILE="/var/log/nft-forward.log"
TABLE4="nft_forward"
TABLE6="nft_forward6"

# realm(用户态转发)
REALM_BIN="/usr/local/bin/realm"
REALM_CONF="$CONF_DIR/realm.toml"
REALM_UNIT="nft-forward-realm"
REALM_UNIT_FILE="/etc/systemd/system/${REALM_UNIT}.service"
REALM_FALLBACK_VER="v2.9.1"

# 在线更新源
RAW_BASE="https://raw.githubusercontent.com/merlin-node/nft-forward/main"
GH_MIRRORS=("" "https://ghproxy.net/" "https://gh-proxy.com/")

# ============ 颜色 ============
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

# ============ 工具函数 ============
log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$LOG_FILE"
}

msg()  { echo -e "${GREEN}[*]${NC} $*"; }
warn() { echo -e "${YELLOW}[!]${NC} $*"; }
err()  { echo -e "${RED}[x]${NC} $*"; }
info() { echo -e "${CYAN}[i]${NC} $*"; }

# 自适应终端宽度,40-80 之间
term_width() {
    local w
    w=$(tput cols 2>/dev/null || echo 60)
    (( w < 40 )) && w=40
    (( w > 80 )) && w=80
    echo "$w"
}

# 普通分割线,默认蓝色,可传颜色变量
hr() {
    local color="${1:-$BLUE}" w
    w=$(term_width)
    printf "${color}%${w}s${NC}\n" '' | tr ' ' '='
}

# 带标题的居中分割线,中文按宽度 2 计
hr_title() {
    local title="$1" color="${2:-$BLUE}" w side_eq
    w=$(term_width)
    local bytes chars non_ascii_chars ascii_chars visual
    bytes=$(printf '%s' " ${title} " | wc -c)
    chars=$(printf '%s' " ${title} " | wc -m)
    non_ascii_chars=$(( (bytes - chars) / 2 ))
    ascii_chars=$(( chars - non_ascii_chars ))
    visual=$(( ascii_chars + non_ascii_chars * 2 ))
    side_eq=$(( (w - visual) / 2 ))
    (( side_eq < 3 )) && side_eq=3
    local left right
    left=$(printf "%${side_eq}s" '' | tr ' ' '=')
    right=$(printf "%${side_eq}s" '' | tr ' ' '=')
    echo -e "${color}${left} ${title} ${right}${NC}"
}

# 细分割线(破折号),用于菜单内部分隔
hr_thin() {
    local color="${1:-$BLUE}" w
    w=$(term_width)
    printf "${color}%${w}s${NC}\n" '' | tr ' ' '-'
}

need_root() {
    if [[ $EUID -ne 0 ]]; then
        err "需要 root 权限,请用 sudo 运行"
        exit 1
    fi
}

# 二次确认 y/n,默认 n
confirm_yn() {
    local prompt="$1"
    local ans
    read -rp "$prompt [y/n]: " ans
    [[ "$ans" =~ ^[Yy]$ ]]
}

pause() {
    echo ""
    read -rp "按回车返回..." _
}

# HTTP 下载到 stdout,curl 优先,没有就用 wget
http_get() {
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL --connect-timeout 10 --max-time 180 "$1"
    elif command -v wget >/dev/null 2>&1; then
        wget -qO- -T 15 -t 2 "$1"
    else
        err "curl 和 wget 都没有,请先 apt install -y curl"
        return 1
    fi
}

# 规则的转发引擎,老规则没有第 8 列,默认 nft
rule_engine() { [[ "$1" == "realm" ]] && echo realm || echo nft; }

# 协议展开成 nft 的 L4 关键字
proto_l4() {
    case "$1" in
        tcpudp) echo "tcp udp" ;;
        udp)    echo "udp" ;;
        *)      echo "tcp" ;;
    esac
}

proto_label() {
    case "$1" in
        tcpudp) echo "TCP+UDP" ;;
        udp)    echo "UDP" ;;
        *)      echo "TCP" ;;
    esac
}

# ============ 初始化 ============
init_files() {
    mkdir -p "$CONF_DIR"
    touch "$LOG_FILE"
    chmod 600 "$LOG_FILE"

    if [[ ! -f "$RULES_FILE" ]]; then
        cat > "$RULES_FILE" <<'EOF'
# nft-forward 规则配置文件
# 格式: ID|协议|本机端口|目标地址|目标端口|地址类型|备注|引擎
# 协议: tcp / udp / tcpudp
# 地址类型: ip / domain
# 引擎: nft / realm (留空视为 nft)
EOF
        chmod 600 "$RULES_FILE"
    fi

    if [[ ! -f "$SETTINGS_FILE" ]]; then
        cat > "$SETTINGS_FILE" <<'EOF'
IPV6_ENABLED=no
DDNS_INTERVAL_MIN=5
EOF
        chmod 600 "$SETTINGS_FILE"
    fi
}

load_settings() {
    # shellcheck disable=SC1090
    source "$SETTINGS_FILE"
    IPV6_ENABLED="${IPV6_ENABLED:-no}"
    DDNS_INTERVAL_MIN="${DDNS_INTERVAL_MIN:-5}"
}

save_settings() {
    cat > "$SETTINGS_FILE" <<EOF
IPV6_ENABLED=$IPV6_ENABLED
DDNS_INTERVAL_MIN=$DDNS_INTERVAL_MIN
EOF
}

# ============ 验证函数 ============
is_valid_port() {
    [[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

is_valid_ipv4() {
    [[ "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 1
    local IFS='.'
    local -a o=($1)
    for n in "${o[@]}"; do
        [ "$n" -le 255 ] || return 1
    done
    return 0
}

is_valid_ipv6() {
    [[ "$1" =~ ^([0-9a-fA-F:]+)$ ]] && [[ "$1" == *:* ]]
}

is_valid_domain() {
    [[ "$1" =~ ^[a-zA-Z0-9]([a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])?(\.[a-zA-Z0-9]([a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])?)+$ ]]
}

resolve_domain_v4() {
    local ip
    ip=$(getent ahostsv4 "$1" 2>/dev/null | awk '{print $1; exit}')
    [[ -n "$ip" ]] && is_valid_ipv4 "$ip" && echo "$ip"
}

resolve_domain_v6() {
    local ip
    ip=$(getent ahostsv6 "$1" 2>/dev/null | awk '{print $1; exit}')
    [[ -n "$ip" ]] && is_valid_ipv6 "$ip" && echo "$ip"
}

# ============ 端口占用检测 ============
check_port_inuse() {
    local port="$1"
    local result
    result=$(ss -Hlntu "sport = :$port" 2>/dev/null | head -1)
    if [[ -n "$result" ]]; then
        local prog
        prog=$(ss -Hlnptu "sport = :$port" 2>/dev/null | grep -oP 'users:\(\("\K[^"]+' | head -1)
        echo "${prog:-未知程序}"
        return 0
    fi
    return 1
}

# ============ 规则管理 ============
next_id() {
    local max=0
    while IFS='|' read -r id _; do
        [[ "$id" =~ ^[0-9]+$ ]] || continue
        [ "$id" -gt "$max" ] && max="$id"
    done < "$RULES_FILE"
    echo $((max + 1))
}

# 重新编号:按文件中的顺序把规则 ID 重排为 1,2,3...
renumber_rules() {
    local tmp
    tmp=$(mktemp)
    awk -F'|' 'BEGIN{OFS="|"; n=0}
        /^[[:space:]]*#/ || /^[[:space:]]*$/ {print; next}
        $1 ~ /^[0-9]+$/ {n++; $1=n; print; next}
        {print}' "$RULES_FILE" > "$tmp"
    mv "$tmp" "$RULES_FILE"
    chmod 600 "$RULES_FILE"
    # DDNS 缓存按 ID 记录,编号变了就清掉,下次检查时自动重建
    rm -f "$CONF_DIR/.ddns_cache"
}

# 参数: 空=全部, nft / realm=只看该引擎
list_rules() {
    local only="${1:-}"
    local title="全部"
    [[ "$only" == "nft" ]] && title="nftables"
    [[ "$only" == "realm" ]] && title="realm"
    echo ""
    info "当前 $title 转发规则:"
    hr_thin
    printf "%-4s %-6s %-8s %-8s %-30s %-8s %s\n" "ID" "引擎" "协议" "本机端口" "目标地址" "目标端口" "备注"
    hr_thin
    local count=0 id proto lport target rport atype note engine
    while IFS='|' read -r id proto lport target rport atype note engine; do
        [[ "$id" =~ ^[0-9]+$ ]] || continue
        [[ -z "$only" || "$(rule_engine "$engine")" == "$only" ]] || continue
        local disp="$target"
        if [[ "$atype" == "domain" ]]; then
            local resolved
            resolved=$(resolve_domain_v4 "$target")
            disp="$target(→${resolved:-未解析})"
        fi
        printf "%-4s %-6s %-8s %-8s %-30s %-8s %s\n" "$id" "$(rule_engine "$engine")" "$(proto_label "$proto")" "$lport" "$disp" "$rport" "${note:--}"
        count=$((count + 1))
    done < "$RULES_FILE"
    hr_thin
    echo "共 $count 条规则"
    echo ""
}

# ============ 添加规则(全数字交互)============
# 参数: nft / realm
add_rule() {
    local engine="${1:-nft}"
    echo ""
    if [[ "$engine" == "realm" ]]; then
        info "添加 realm 转发规则(任意步骤输入 0 取消)"
    else
        info "添加 nftables 转发规则(任意步骤输入 0 取消)"
    fi
    echo ""

    if [[ "$engine" == "realm" ]] && [[ ! -x "$REALM_BIN" ]]; then
        warn "realm 还没安装"
        if confirm_yn "现在安装?"; then
            realm_install || return
        else
            info "已取消"; return
        fi
    fi

    # 协议
    echo "选择协议:"
    echo "  1) TCP + UDP"
    echo "  2) 仅 TCP"
    echo "  3) 仅 UDP"
    echo "  0) 取消返回"
    local p proto
    read -rp "请选择 [0-3]: " p
    case "$p" in
        0) info "已取消"; return ;;
        1) proto="tcpudp" ;;
        2) proto="tcp" ;;
        3) proto="udp" ;;
        *) err "无效选择"; return ;;
    esac

    # 本机端口
    local lport
    while true; do
        echo ""
        read -rp "本机监听端口 (1-65535, 输入 0 取消): " lport
        [[ "$lport" == "0" ]] && { info "已取消"; return; }
        if ! is_valid_port "$lport"; then
            err "端口无效"
            continue
        fi
        if grep -qE "^[0-9]+\|[^|]+\|$lport\|" "$RULES_FILE"; then
            err "端口 $lport 已被本脚本其他规则占用"
            continue
        fi
        local occ
        occ=$(check_port_inuse "$lport")
        if [[ -n "$occ" ]]; then
            warn "端口 $lport 已被系统进程占用: $occ"
            if ! confirm_yn "仍要使用此端口?"; then
                continue
            fi
        fi
        break
    done

    # 目标地址类型
    echo ""
    echo "目标地址类型:"
    echo "  1) IP 地址(固定IP)"
    if [[ "$engine" == "realm" ]]; then
        echo "  2) 域名(由 realm 实时解析)"
    else
        echo "  2) 域名(动态IP,自动定时更新)"
    fi
    echo "  0) 取消返回"
    local t atype target
    read -rp "请选择 [0-2]: " t
    case "$t" in
        0) info "已取消"; return ;;
        1)
            atype="ip"
            local ip_hint="IPv4"
            [[ "$engine" == "realm" ]] && ip_hint="IPv4/IPv6"
            while true; do
                read -rp "目标 $ip_hint 地址 (输入 0 取消): " target
                [[ "$target" == "0" ]] && { info "已取消"; return; }
                target="${target#[}"; target="${target%]}"
                if is_valid_ipv4 "$target"; then break; fi
                if [[ "$engine" == "realm" ]] && is_valid_ipv6 "$target"; then break; fi
                err "IP 格式无效"
            done
            ;;
        2)
            atype="domain"
            while true; do
                read -rp "目标域名 (输入 0 取消): " target
                [[ "$target" == "0" ]] && { info "已取消"; return; }
                if ! is_valid_domain "$target"; then
                    err "域名格式无效"
                    continue
                fi
                local rip
                rip=$(resolve_domain_v4 "$target")
                if [[ -z "$rip" ]]; then
                    warn "域名当前解析失败"
                    if ! confirm_yn "仍要保存?"; then
                        continue
                    fi
                else
                    info "域名当前解析为: $rip"
                fi
                break
            done
            ;;
        *) err "无效选择"; return ;;
    esac

    # 目标端口
    local rport
    while true; do
        echo ""
        read -rp "目标端口 (1-65535, 输入 0 取消): " rport
        [[ "$rport" == "0" ]] && { info "已取消"; return; }
        if is_valid_port "$rport"; then break; fi
        err "端口无效"
    done

    # 备注
    echo ""
    read -rp "备注(可选,回车跳过): " note
    note="${note//|/-}"

    # 最终确认
    echo ""
    info "规则预览:"
    echo "  引擎:     $engine"
    echo "  协议:     $(proto_label "$proto")"
    echo "  本机端口: $lport"
    echo "  目标:     $target:$rport ($atype)"
    echo "  备注:     ${note:--}"
    echo ""
    if ! confirm_yn "确认添加这条规则?"; then
        info "已取消"
        return
    fi

    local id
    id=$(next_id)
    echo "$id|$proto|$lport|$target|$rport|$atype|$note|$engine" >> "$RULES_FILE"
    msg "规则已添加 (ID=$id)"
    log "ADD rule id=$id [$engine] $proto $lport -> $target:$rport ($atype) note=$note"

    apply_engine "$engine"
}

# ============ 删除规则(带 y/n 确认)============
# 参数: nft / realm,只能删该引擎的规则
del_rule() {
    local engine="${1:-nft}"
    local label="nftables"
    [[ "$engine" == "realm" ]] && label="realm"
    while true; do
        list_rules "$engine"
        echo "  0) 返回上级"
        echo ""
        read -rp "输入要删除的规则 ID(多个空格分隔,输入 all 清空全部 $label 规则,0 返回): " ids
        if [[ -z "$ids" ]] || [[ "$ids" == "0" ]]; then
            return
        fi

        if [[ "$ids" == "all" ]]; then
            echo ""
            warn "即将清空全部 $label 规则!(另一种引擎的规则不受影响)"
            if ! confirm_yn "确认清空?"; then
                info "已取消"
                continue
            fi
            local tmp
            tmp=$(mktemp)
            # 保留注释、空行和另一种引擎的规则
            awk -F'|' -v e="$engine" '
                $1 !~ /^[0-9]+$/ {print; next}
                { r = ($8 == "realm") ? "realm" : "nft"; if (r != e) print }' "$RULES_FILE" > "$tmp"
            mv "$tmp" "$RULES_FILE"
            chmod 600 "$RULES_FILE"
            renumber_rules
            msg "已清空全部 $label 规则"
            log "DEL all $engine rules"
            apply_engine "$engine"
            return
        fi

        # 检查 ID 是否都存在
        local valid_ids=()
        local invalid=()
        for id in $ids; do
            if [[ ! "$id" =~ ^[0-9]+$ ]]; then
                invalid+=("$id")
                continue
            fi
            local line
            line=$(grep -E "^$id\|" "$RULES_FILE" | head -1)
            if [[ -n "$line" ]] && [[ "$(rule_engine "$(echo "$line" | cut -d'|' -f8)")" == "$engine" ]]; then
                valid_ids+=("$id")
            else
                invalid+=("$id")
            fi
        done

        if [[ ${#invalid[@]} -gt 0 ]]; then
            warn "以下 ID 无效或不属于 $label: ${invalid[*]}"
        fi
        if [[ ${#valid_ids[@]} -eq 0 ]]; then
            err "没有有效的 ID 可删除"
            continue
        fi

        echo ""
        info "即将删除以下规则 ID: ${valid_ids[*]}"
        if ! confirm_yn "确认删除?"; then
            info "已取消"
            continue
        fi

        local tmp
        tmp=$(mktemp)
        cp "$RULES_FILE" "$tmp"
        for id in "${valid_ids[@]}"; do
            sed -i "/^$id|/d" "$tmp"
            msg "已删除 ID=$id"
            log "DEL rule id=$id"
        done
        mv "$tmp" "$RULES_FILE"
        chmod 600 "$RULES_FILE"
        renumber_rules
        apply_engine "$engine"
        return
    done
}

# ============ 生成 nftables 配置 ============
generate_nft() {
    local v6="$1"
    local tmp
    tmp=$(mktemp)

    cat > "$tmp" <<EOT
#!/usr/sbin/nft -f
# 本文件由 nft-forward 自动生成,请勿手动编辑

table ip $TABLE4
delete table ip $TABLE4
EOT

    if [[ "$v6" == "yes" ]]; then
        cat >> "$tmp" <<EOT
table ip6 $TABLE6
delete table ip6 $TABLE6
EOT
    fi

    # 先把 nft 规则解析一遍,prerouting/postrouting 共用,避免同一域名解析两次结果不一致
    local -a pre4=() post4=() pre6=() post6=()
    local id proto lport target rport atype note engine l4
    while IFS='|' read -r id proto lport target rport atype note engine; do
        [[ "$id" =~ ^[0-9]+$ ]] || continue
        [[ "$(rule_engine "$engine")" == "nft" ]] || continue

        local dest_ip
        if [[ "$atype" == "ip" ]]; then
            dest_ip="$target"
        else
            dest_ip=$(resolve_domain_v4 "$target")
            if [[ -z "$dest_ip" ]]; then
                warn "规则 ID=$id 域名 $target 解析失败,本次跳过"
                log "RESOLVE failed v4: rule id=$id domain=$target"
                # 清掉缓存,保证下次 DDNS 检查一定会重新应用
                sed -i "/^$id:v4:/d" "$CONF_DIR/.ddns_cache" 2>/dev/null
            fi
        fi
        if [[ -n "$dest_ip" ]]; then
            for l4 in $(proto_l4 "$proto"); do
                pre4+=("$l4 dport $lport dnat to $dest_ip:$rport")
                post4+=("ip daddr $dest_ip $l4 dport $rport masquerade")
            done
        fi

        if [[ "$v6" == "yes" ]] && [[ "$atype" == "domain" ]]; then
            local dest_ip6
            dest_ip6=$(resolve_domain_v6 "$target")
            if [[ -z "$dest_ip6" ]]; then
                log "RESOLVE failed v6: rule id=$id domain=$target"
            else
                for l4 in $(proto_l4 "$proto"); do
                    pre6+=("$l4 dport $lport dnat to [$dest_ip6]:$rport")
                    post6+=("ip6 daddr $dest_ip6 $l4 dport $rport masquerade")
                done
            fi
        fi
    done < "$RULES_FILE"

    {
        echo ""
        echo "table ip $TABLE4 {"
        echo "    chain prerouting {"
        echo "        type nat hook prerouting priority dstnat; policy accept;"
        for l4 in "${pre4[@]}"; do echo "        $l4"; done
        echo "    }"
        echo ""
        echo "    chain postrouting {"
        echo "        type nat hook postrouting priority srcnat; policy accept;"
        for l4 in "${post4[@]}"; do echo "        $l4"; done
        echo "    }"
        echo "}"
        if [[ "$v6" == "yes" ]]; then
            echo ""
            echo "table ip6 $TABLE6 {"
            echo "    chain prerouting {"
            echo "        type nat hook prerouting priority dstnat; policy accept;"
            for l4 in "${pre6[@]}"; do echo "        $l4"; done
            echo "    }"
            echo ""
            echo "    chain postrouting {"
            echo "        type nat hook postrouting priority srcnat; policy accept;"
            for l4 in "${post6[@]}"; do echo "        $l4"; done
            echo "    }"
            echo "}"
        fi
    } >> "$tmp"

    mv "$tmp" "$NFT_FILE"
    chmod 600 "$NFT_FILE"
}

# ============ 应用规则 ============
# 只应用某一边:nft / realm
apply_engine() {
    if [[ "$1" == "realm" ]]; then apply_realm; else apply_nft; fi
}

# 两边都应用
apply_rules() {
    local rc=0
    apply_nft || rc=1
    apply_realm || rc=1
    return $rc
}

apply_nft() {
    load_settings

    sysctl -w net.ipv4.ip_forward=1 >/dev/null 2>&1
    if [[ "$IPV6_ENABLED" == "yes" ]]; then
        sysctl -w net.ipv6.conf.all.forwarding=1 >/dev/null 2>&1
    fi
    local sysctl_file="/etc/sysctl.d/99-nft-forward.conf"
    cat > "$sysctl_file" <<EOF
net.ipv4.ip_forward=1
EOF
    if [[ "$IPV6_ENABLED" == "yes" ]]; then
        echo "net.ipv6.conf.all.forwarding=1" >> "$sysctl_file"
    fi

    generate_nft "$IPV6_ENABLED"

    nft list table ip $TABLE4 >/dev/null 2>&1 && nft delete table ip $TABLE4 2>/dev/null
    # IPv6 关掉时也要把旧的 v6 表清掉,否则会一直残留生效
    nft list table ip6 $TABLE6 >/dev/null 2>&1 && nft delete table ip6 $TABLE6 2>/dev/null

    local rc=0
    if nft -f "$NFT_FILE" 2>/tmp/nft-err; then
        msg "nftables 规则已生效"
        log "APPLY ok"
    else
        err "应用失败:"
        cat /tmp/nft-err
        log "APPLY failed: $(cat /tmp/nft-err)"
        rc=1
    fi
    return $rc
}

# ============ realm ============
realm_rule_count() {
    awk -F'|' '$1 ~ /^[0-9]+$/ && $8 == "realm" {n++} END {print n+0}' "$RULES_FILE"
}

realm_version() {
    [[ -x "$REALM_BIN" ]] || { echo "未安装"; return; }
    "$REALM_BIN" --version 2>/dev/null | awk '{print $NF; exit}'
}

realm_state() {
    systemctl is-active "$REALM_UNIT" 2>/dev/null || true
}

generate_realm() {
    local out="$1" listen_host="0.0.0.0"
    # 有 IPv6 栈就监听 [::],Linux 默认双栈,v4 v6 都能进
    [[ -f /proc/net/if_inet6 ]] && listen_host="[::]"

    cat > "$out" <<EOF
# 本文件由 nft-forward 自动生成,请勿手动编辑

[log]
level = "warn"

[network]
no_tcp = false
use_udp = false
EOF

    local id proto lport target rport atype note engine remote
    while IFS='|' read -r id proto lport target rport atype note engine; do
        [[ "$id" =~ ^[0-9]+$ ]] || continue
        [[ "$engine" == "realm" ]] || continue
        remote="$target:$rport"
        is_valid_ipv6 "$target" && remote="[$target]:$rport"
        {
            echo ""
            echo "# ID=$id${note:+ $note}"
            echo "[[endpoints]]"
            echo "listen = \"$listen_host:$lport\""
            echo "remote = \"$remote\""
            case "$proto" in
                tcpudp) echo "network = { use_udp = true }" ;;
                udp)    echo "network = { no_tcp = true, use_udp = true }" ;;
            esac
        } >> "$out"
    done < "$RULES_FILE"
}

ensure_realm_unit() {
    local tmp
    tmp=$(mktemp)
    cat > "$tmp" <<EOF
[Unit]
Description=nft-forward realm relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=$REALM_BIN -c $REALM_CONF
Restart=on-failure
RestartSec=3
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
EOF
    if ! cmp -s "$tmp" "$REALM_UNIT_FILE"; then
        mv "$tmp" "$REALM_UNIT_FILE"
        chmod 644 "$REALM_UNIT_FILE"
        systemctl daemon-reload
    else
        rm -f "$tmp"
    fi
}

# 按规则生成 realm 配置;配置没变且服务在跑就不动它,不打断现有连接
apply_realm() {
    local n
    n=$(realm_rule_count)

    if (( n == 0 )); then
        if [[ -f "$REALM_UNIT_FILE" ]]; then
            systemctl disable --now --no-block "$REALM_UNIT" >/dev/null 2>&1
        fi
        rm -f "$REALM_CONF"
        return 0
    fi

    if [[ ! -x "$REALM_BIN" ]]; then
        warn "有 $n 条 realm 规则,但 realm 未安装(主菜单 8 → 安装)"
        log "REALM not installed, $n rules skipped"
        return 1
    fi

    ensure_realm_unit
    local tmp changed=1
    tmp=$(mktemp)
    generate_realm "$tmp"
    cmp -s "$tmp" "$REALM_CONF" && changed=0
    mv "$tmp" "$REALM_CONF"
    chmod 600 "$REALM_CONF"
    systemctl enable "$REALM_UNIT" >/dev/null 2>&1

    local st
    st=$(realm_state)
    if (( changed == 0 )) && [[ "$st" == "active" || "$st" == "activating" ]]; then
        return 0
    fi

    # 被 systemd 调用(开机 apply)时不能同步等 realm 启动,否则会和 network-online 互相等待
    if [[ -n "${INVOCATION_ID:-}" ]]; then
        systemctl --no-block restart "$REALM_UNIT"
        log "REALM restart queued ($n rules)"
        return 0
    fi

    systemctl restart "$REALM_UNIT"
    sleep 1
    if [[ "$(realm_state)" == "active" ]]; then
        msg "realm 规则已生效 ($n 条)"
        log "REALM apply ok ($n rules)"
    else
        err "realm 启动失败,最近日志:"
        journalctl -u "$REALM_UNIT" -n 15 --no-pager 2>/dev/null
        log "REALM apply failed"
        return 1
    fi
}

realm_install() {
    local arch
    case "$(uname -m)" in
        x86_64|amd64)  arch="x86_64-unknown-linux-gnu" ;;
        aarch64|arm64) arch="aarch64-unknown-linux-gnu" ;;
        *) err "不支持的架构: $(uname -m)"; return 1 ;;
    esac

    msg "查询 realm 最新版本..."
    local ver
    ver=$(http_get "https://api.github.com/repos/zhboner/realm/releases/latest" 2>/dev/null \
        | grep -oP '"tag_name"\s*:\s*"\K[^"]+' | head -1)
    if [[ -z "$ver" ]]; then
        ver="$REALM_FALLBACK_VER"
        warn "GitHub API 不可用,使用保底版本 $ver"
    else
        info "最新版本: $ver"
    fi

    local cur
    cur=$(realm_version)
    if [[ "$cur" != "未安装" ]] && [[ "v${cur#v}" == "$ver" ]]; then
        info "已是最新版本 ($cur)"
        return 0
    fi

    local url="https://github.com/zhboner/realm/releases/download/$ver/realm-$arch.tar.gz"
    local tmpdir ok=0 m
    tmpdir=$(mktemp -d)
    for m in "${GH_MIRRORS[@]}"; do
        msg "下载: ${m:-GitHub 直连}${m:+ (镜像)}"
        if http_get "${m}${url}" > "$tmpdir/realm.tgz" 2>/dev/null \
            && tar -tzf "$tmpdir/realm.tgz" 2>/dev/null | grep -qE '(^|/)realm$'; then
            ok=1; break
        fi
        warn "该源不可用,换下一个..."
    done
    if (( ok == 0 )); then
        err "realm 下载失败,请检查网络"
        rm -rf "$tmpdir"
        return 1
    fi

    tar -xzf "$tmpdir/realm.tgz" -C "$tmpdir"
    local bin
    bin=$(find "$tmpdir" -type f -name realm | head -1)
    if [[ -z "$bin" ]] || ! "$bin" --version >/dev/null 2>&1; then
        err "解压出的 realm 无法运行"
        rm -rf "$tmpdir"
        return 1
    fi
    install -m 755 "$bin" "$REALM_BIN"
    rm -rf "$tmpdir"
    msg "realm $(realm_version) 已安装到 $REALM_BIN"
    log "REALM installed $ver"

    ensure_realm_unit
    # 升级时强制重启,换上新二进制
    if (( $(realm_rule_count) > 0 )); then
        rm -f "$REALM_CONF"
        apply_realm
    fi
}

realm_uninstall() {
    local n
    n=$(realm_rule_count)
    echo ""
    if (( n > 0 )); then
        warn "当前有 $n 条 realm 规则,卸载后这些规则会失效(规则本身保留)"
    fi
    if ! confirm_yn "确认卸载 realm?"; then
        info "已取消"
        return
    fi
    systemctl disable --now "$REALM_UNIT" >/dev/null 2>&1
    rm -f "$REALM_UNIT_FILE" "$REALM_CONF"
    systemctl daemon-reload
    # 别的脚本(如 Net-Forwarder)也在用 realm 时,保留二进制
    if [[ -f /etc/systemd/system/realm.service ]]; then
        warn "检测到其他 realm.service,保留 $REALM_BIN"
    else
        rm -f "$REALM_BIN"
    fi
    msg "realm 已卸载"
    log "REALM uninstalled"
}

realm_menu() {
    while true; do
        clear
        hr
        hr_title "realm 管理"
        hr
        echo -e "  状态:      $(state_color "$(realm_state)")"
        echo "  规则:      $(realm_rule_count) 条"
        echo "  版本:      $(realm_version)"
        hr_thin
        echo "  1) 重新应用 realm 规则(重启 realm)"
        echo "  2) 查看生成的 realm 配置"
        echo "  3) 查看 realm 日志(最后30行)"
        echo "  4) 安装 / 更新 realm"
        echo "  5) 卸载 realm"
        echo "  0) 返回上级"
        hr_thin
        local c
        read -rp "选择: " c
        case "$c" in
            1) rm -f "$REALM_CONF"; apply_realm; pause ;;
            2) cat "$REALM_CONF" 2>/dev/null || info "暂无(没有 realm 规则)"; pause ;;
            3) journalctl -u "$REALM_UNIT" -n 30 --no-pager 2>/dev/null; pause ;;
            4) realm_install; pause ;;
            5) realm_uninstall; pause ;;
            0) return ;;
            *) warn "无效选择"; sleep 1 ;;
        esac
    done
}

# ============ DDNS 更新 ============
ddns_update() {
    load_settings
    local need_reload=0
    local state_file="$CONF_DIR/.ddns_cache"
    touch "$state_file"

    local id proto lport target rport atype note engine
    while IFS='|' read -r id proto lport target rport atype note engine; do
        [[ "$id" =~ ^[0-9]+$ ]] || continue
        [[ "$atype" == "domain" ]] || continue
        # realm 自己解析域名,不需要 DDNS
        [[ "$(rule_engine "$engine")" == "nft" ]] || continue
        local new_ip
        new_ip=$(resolve_domain_v4 "$target")
        if [[ -n "$new_ip" ]]; then
            local old_ip
            old_ip=$(grep "^$id:v4:" "$state_file" | cut -d: -f3)
            # 缓存一致但内核里没有这条 dnat(开机解析失败被跳过、表被清掉等),也要重载
            local live_ok=1
            nft list chain ip $TABLE4 prerouting 2>/dev/null | grep -qF "dnat to $new_ip:$rport" || live_ok=0
            if [[ "$new_ip" != "$old_ip" ]] || [[ "$live_ok" == "0" ]]; then
                [[ "$live_ok" == "0" ]] && log "DDNS rule=$id $target v4: $new_ip 未在 nft 中生效,重新应用"
                sed -i "/^$id:v4:/d" "$state_file"
                echo "$id:v4:$new_ip" >> "$state_file"
                need_reload=1
                log "DDNS rule=$id $target v4: $old_ip -> $new_ip"
            fi
        fi

        if [[ "$IPV6_ENABLED" == "yes" ]]; then
            local new_ip6
            new_ip6=$(resolve_domain_v6 "$target")
            if [[ -n "$new_ip6" ]]; then
                local old_ip6
                old_ip6=$(grep "^$id:v6:" "$state_file" | cut -d: -f3-)
                if [[ "$new_ip6" != "$old_ip6" ]]; then
                    sed -i "/^$id:v6:/d" "$state_file"
                    echo "$id:v6:$new_ip6" >> "$state_file"
                    need_reload=1
                    log "DDNS rule=$id $target v6: $old_ip6 -> $new_ip6"
                fi
            fi
        fi
    done < "$RULES_FILE"

    if [[ "$need_reload" == "1" ]]; then
        apply_nft
    fi
}

# ============ 设置子菜单 ============
toggle_ipv6() {
    load_settings
    echo ""
    info "当前 IPv6 转发状态: $IPV6_ENABLED"
    echo ""
    local target_state
    if [[ "$IPV6_ENABLED" == "yes" ]]; then
        target_state="no"
        echo "即将关闭 IPv6 转发"
    else
        target_state="yes"
        echo "即将开启 IPv6 转发"
    fi
    if ! confirm_yn "确认切换?"; then
        info "已取消"
        return
    fi
    IPV6_ENABLED="$target_state"
    save_settings
    msg "IPv6 已设置为: $IPV6_ENABLED"
    apply_nft
}

set_ddns_interval() {
    load_settings
    echo ""
    info "当前 DDNS 检查间隔: ${DDNS_INTERVAL_MIN} 分钟"
    echo ""
    local m
    read -rp "新间隔(分钟,1-1440, 输入 0 取消): " m
    if [[ "$m" == "0" ]] || [[ -z "$m" ]]; then
        info "已取消"
        return
    fi
    if ! [[ "$m" =~ ^[0-9]+$ ]] || [ "$m" -lt 1 ] || [ "$m" -gt 1440 ]; then
        err "无效输入"
        return
    fi
    echo ""
    info "即将把 DDNS 检查间隔改为 $m 分钟"
    if ! confirm_yn "确认修改?"; then
        info "已取消"
        return
    fi
    DDNS_INTERVAL_MIN="$m"
    save_settings
    sed -i "s|^OnUnitActiveSec=.*|OnUnitActiveSec=${m}min|" /etc/systemd/system/nft-forward-ddns.timer 2>/dev/null
    systemctl daemon-reload
    systemctl restart nft-forward-ddns.timer 2>/dev/null
    msg "DDNS 检查间隔已更新为 $m 分钟"
}

