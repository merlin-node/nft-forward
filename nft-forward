#!/bin/bash
# nft-forward - nftables 中转管理脚本
# 适用系统: Debian 13

set -o pipefail

# ============ 路径配置 ============
CONF_DIR="/etc/nft-forward"
RULES_FILE="$CONF_DIR/rules.conf"
SETTINGS_FILE="$CONF_DIR/settings.conf"
NFT_FILE="/etc/nftables-forward.conf"
LOG_FILE="/var/log/nft-forward.log"
TABLE4="nft_forward"
TABLE6="nft_forward6"

# ============ 颜色 ============
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

# ============ 工具函数 ============
log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$LOG_FILE"
}

msg()  { echo -e "${GREEN}[*]${NC} $*"; }
warn() { echo -e "${YELLOW}[!]${NC} $*"; }
err()  { echo -e "${RED}[x]${NC} $*"; }
info() { echo -e "${CYAN}[i]${NC} $*"; }

# 自适应终端宽度,40-80 之间
term_width() {
    local w
    w=$(tput cols 2>/dev/null || echo 60)
    (( w < 40 )) && w=40
    (( w > 80 )) && w=80
    echo "$w"
}

# 普通分割线,默认蓝色,可传颜色变量
hr() {
    local color="${1:-$BLUE}" w
    w=$(term_width)
    printf "${color}%${w}s${NC}\n" '' | tr ' ' '='
}

# 带标题的居中分割线,中文按宽度 2 计
hr_title() {
    local title="$1" color="${2:-$BLUE}" w side_eq
    w=$(term_width)
    local bytes chars non_ascii_chars ascii_chars visual
    bytes=$(printf '%s' " ${title} " | wc -c)
    chars=$(printf '%s' " ${title} " | wc -m)
    non_ascii_chars=$(( (bytes - chars) / 2 ))
    ascii_chars=$(( chars - non_ascii_chars ))
    visual=$(( ascii_chars + non_ascii_chars * 2 ))
    side_eq=$(( (w - visual) / 2 ))
    (( side_eq < 3 )) && side_eq=3
    local left right
    left=$(printf "%${side_eq}s" '' | tr ' ' '=')
    right=$(printf "%${side_eq}s" '' | tr ' ' '=')
    echo -e "${color}${left} ${title} ${right}${NC}"
}

# 细分割线(破折号),用于菜单内部分隔
hr_thin() {
    local color="${1:-$BLUE}" w
    w=$(term_width)
    printf "${color}%${w}s${NC}\n" '' | tr ' ' '-'
}

need_root() {
    if [[ $EUID -ne 0 ]]; then
        err "需要 root 权限,请用 sudo 运行"
        exit 1
    fi
}

# 二次确认 y/n,默认 n
confirm_yn() {
    local prompt="$1"
    local ans
    read -rp "$prompt [y/n]: " ans
    [[ "$ans" =~ ^[Yy]$ ]]
}

pause() {
    echo ""
    read -rp "按回车返回..." _
}

# ============ 初始化 ============
init_files() {
    mkdir -p "$CONF_DIR"
    touch "$LOG_FILE"
    chmod 600 "$LOG_FILE"

    if [[ ! -f "$RULES_FILE" ]]; then
        cat > "$RULES_FILE" <<'EOF'
# nft-forward 规则配置文件
# 格式: ID|协议|本机端口|目标地址|目标端口|地址类型|备注
# 协议: tcp / tcpudp
# 地址类型: ip / domain
EOF
        chmod 600 "$RULES_FILE"
    fi

    if [[ ! -f "$SETTINGS_FILE" ]]; then
        cat > "$SETTINGS_FILE" <<'EOF'
IPV6_ENABLED=no
DDNS_INTERVAL_MIN=5
EOF
        chmod 600 "$SETTINGS_FILE"
    fi
}

load_settings() {
    # shellcheck disable=SC1090
    source "$SETTINGS_FILE"
    IPV6_ENABLED="${IPV6_ENABLED:-no}"
    DDNS_INTERVAL_MIN="${DDNS_INTERVAL_MIN:-5}"
}

save_settings() {
    cat > "$SETTINGS_FILE" <<EOF
IPV6_ENABLED=$IPV6_ENABLED
DDNS_INTERVAL_MIN=$DDNS_INTERVAL_MIN
EOF
}

# ============ 验证函数 ============
is_valid_port() {
    [[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

is_valid_ipv4() {
    [[ "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 1
    local IFS='.'
    local -a o=($1)
    for n in "${o[@]}"; do
        [ "$n" -le 255 ] || return 1
    done
    return 0
}

is_valid_ipv6() {
    [[ "$1" =~ ^([0-9a-fA-F:]+)$ ]] && [[ "$1" == *:* ]]
}

is_valid_domain() {
    [[ "$1" =~ ^[a-zA-Z0-9]([a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])?(\.[a-zA-Z0-9]([a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])?)+$ ]]
}

resolve_domain_v4() {
    local ip
    ip=$(getent ahostsv4 "$1" 2>/dev/null | awk '{print $1; exit}')
    [[ -n "$ip" ]] && is_valid_ipv4 "$ip" && echo "$ip"
}

resolve_domain_v6() {
    local ip
    ip=$(getent ahostsv6 "$1" 2>/dev/null | awk '{print $1; exit}')
    [[ -n "$ip" ]] && is_valid_ipv6 "$ip" && echo "$ip"
}

# ============ 端口占用检测 ============
check_port_inuse() {
    local port="$1"
    local result
    result=$(ss -Hlntu "sport = :$port" 2>/dev/null | head -1)
    if [[ -n "$result" ]]; then
        local prog
        prog=$(ss -Hlnptu "sport = :$port" 2>/dev/null | grep -oP 'users:\(\("\K[^"]+' | head -1)
        echo "${prog:-未知程序}"
        return 0
    fi
    return 1
}

# ============ 规则管理 ============
next_id() {
    local max=0
    while IFS='|' read -r id _; do
        [[ "$id" =~ ^[0-9]+$ ]] || continue
        [ "$id" -gt "$max" ] && max="$id"
    done < "$RULES_FILE"
    echo $((max + 1))
}

list_rules() {
    echo ""
    info "当前转发规则:"
    hr_thin
    printf "%-4s %-8s %-8s %-30s %-8s %s\n" "ID" "协议" "本机端口" "目标地址" "目标端口" "备注"
    hr_thin
    local count=0
    while IFS='|' read -r id proto lport target rport atype note; do
        [[ "$id" =~ ^[0-9]+$ ]] || continue
        local disp="$target"
        if [[ "$atype" == "domain" ]]; then
            local resolved
            resolved=$(resolve_domain_v4 "$target")
            disp="$target(→${resolved:-未解析})"
        fi
        printf "%-4s %-8s %-8s %-30s %-8s %s\n" "$id" "$proto" "$lport" "$disp" "$rport" "${note:--}"
        count=$((count + 1))
    done < "$RULES_FILE"
    hr_thin
    echo "共 $count 条规则"
    echo ""
}

# ============ 添加规则(全数字交互)============
add_rule() {
    echo ""
    info "添加转发规则(任意步骤输入 0 取消)"
    echo ""

    # 协议
    echo "选择协议:"
    echo "  1) TCP + UDP"
    echo "  2) 仅 TCP"
    echo "  0) 取消返回"
    local p proto
    read -rp "请选择 [0-2]: " p
    case "$p" in
        0) info "已取消"; return ;;
        1) proto="tcpudp" ;;
        2) proto="tcp" ;;
        *) err "无效选择"; return ;;
    esac

    # 本机端口
    local lport
    while true; do
        echo ""
        read -rp "本机监听端口 (1-65535, 输入 0 取消): " lport
        [[ "$lport" == "0" ]] && { info "已取消"; return; }
        if ! is_valid_port "$lport"; then
            err "端口无效"
            continue
        fi
        if grep -qE "^[0-9]+\|[^|]+\|$lport\|" "$RULES_FILE"; then
            err "端口 $lport 已被本脚本其他规则占用"
            continue
        fi
        local occ
        occ=$(check_port_inuse "$lport")
        if [[ -n "$occ" ]]; then
            warn "端口 $lport 已被系统进程占用: $occ"
            if ! confirm_yn "仍要使用此端口?"; then
                continue
            fi
        fi
        break
    done

    # 目标地址类型
    echo ""
    echo "目标地址类型:"
    echo "  1) IP 地址(固定IP)"
    echo "  2) 域名(动态IP,自动定时更新)"
    echo "  0) 取消返回"
    local t atype target
    read -rp "请选择 [0-2]: " t
    case "$t" in
        0) info "已取消"; return ;;
        1)
            atype="ip"
            while true; do
                read -rp "目标 IPv4 地址 (输入 0 取消): " target
                [[ "$target" == "0" ]] && { info "已取消"; return; }
                if is_valid_ipv4 "$target"; then break; fi
                err "IP 格式无效"
            done
            ;;
        2)
            atype="domain"
            while true; do
                read -rp "目标域名 (输入 0 取消): " target
                [[ "$target" == "0" ]] && { info "已取消"; return; }
                if ! is_valid_domain "$target"; then
                    err "域名格式无效"
                    continue
                fi
                local rip
                rip=$(resolve_domain_v4 "$target")
                if [[ -z "$rip" ]]; then
                    warn "域名当前解析失败"
                    if ! confirm_yn "仍要保存?"; then
                        continue
                    fi
                else
                    info "域名当前解析为: $rip"
                fi
                break
            done
            ;;
        *) err "无效选择"; return ;;
    esac

    # 目标端口
    local rport
    while true; do
        echo ""
        read -rp "目标端口 (1-65535, 输入 0 取消): " rport
        [[ "$rport" == "0" ]] && { info "已取消"; return; }
        if is_valid_port "$rport"; then break; fi
        err "端口无效"
    done

    # 备注
    echo ""
    read -rp "备注(可选,回车跳过): " note
    note="${note//|/-}"

    # 最终确认
    echo ""
    info "规则预览:"
    echo "  协议:     $proto"
    echo "  本机端口: $lport"
    echo "  目标:     $target:$rport ($atype)"
    echo "  备注:     ${note:--}"
    echo ""
    if ! confirm_yn "确认添加这条规则?"; then
        info "已取消"
        return
    fi

    local id
    id=$(next_id)
    echo "$id|$proto|$lport|$target|$rport|$atype|$note" >> "$RULES_FILE"
    msg "规则已添加 (ID=$id)"
    log "ADD rule id=$id $proto $lport -> $target:$rport ($atype) note=$note"

    apply_rules
}

# ============ 删除规则(带 y/n 确认)============
del_rule() {
    while true; do
        list_rules
        echo "  0) 返回上级"
        echo ""
        read -rp "输入要删除的规则 ID(多个空格分隔,输入 all 全部清空,0 返回): " ids
        if [[ -z "$ids" ]] || [[ "$ids" == "0" ]]; then
            return
        fi

        if [[ "$ids" == "all" ]]; then
            echo ""
            warn "即将清空全部规则!"
            if ! confirm_yn "确认清空?"; then
                info "已取消"
                continue
            fi
            local tmp
            tmp=$(mktemp)
            grep -E '^\s*#|^\s*$' "$RULES_FILE" > "$tmp" || true
            mv "$tmp" "$RULES_FILE"
            chmod 600 "$RULES_FILE"
            msg "已清空全部规则"
            log "DEL all rules"
            apply_rules
            return
        fi

        # 检查 ID 是否都存在
        local valid_ids=()
        local invalid=()
        for id in $ids; do
            if [[ ! "$id" =~ ^[0-9]+$ ]]; then
                invalid+=("$id")
                continue
            fi
            if grep -qE "^$id\|" "$RULES_FILE"; then
                valid_ids+=("$id")
            else
                invalid+=("$id")
            fi
        done

        if [[ ${#invalid[@]} -gt 0 ]]; then
            warn "以下 ID 无效或不存在: ${invalid[*]}"
        fi
        if [[ ${#valid_ids[@]} -eq 0 ]]; then
            err "没有有效的 ID 可删除"
            continue
        fi

        echo ""
        info "即将删除以下规则 ID: ${valid_ids[*]}"
        if ! confirm_yn "确认删除?"; then
            info "已取消"
            continue
        fi

        local tmp
        tmp=$(mktemp)
        cp "$RULES_FILE" "$tmp"
        for id in "${valid_ids[@]}"; do
            sed -i "/^$id|/d" "$tmp"
            msg "已删除 ID=$id"
            log "DEL rule id=$id"
        done
        mv "$tmp" "$RULES_FILE"
        chmod 600 "$RULES_FILE"
        apply_rules
        return
    done
}

# ============ 生成 nftables 配置 ============
generate_nft() {
    local v6="$1"
    local tmp
    tmp=$(mktemp)

    cat > "$tmp" <<EOF
#!/usr/sbin/nft -f
# 本文件由 nft-forward 自动生成,请勿手动编辑

table ip $TABLE4
delete table ip $TABLE4
EOF

    if [[ "$v6" == "yes" ]]; then
        cat >> "$tmp" <<EOF
table ip6 $TABLE6
delete table ip6 $TABLE6
EOF
    fi

    cat >> "$tmp" <<EOF

table ip $TABLE4 {
    chain prerouting {
        type nat hook prerouting priority dstnat; policy accept;
EOF

    while IFS='|' read -r id proto lport target rport atype note; do
        [[ "$id" =~ ^[0-9]+$ ]] || continue
        local dest_ip
        if [[ "$atype" == "ip" ]]; then
            dest_ip="$target"
        else
            dest_ip=$(resolve_domain_v4 "$target")
            if [[ -z "$dest_ip" ]]; then
                warn "规则 ID=$id 域名 $target 解析失败,本次跳过"
                log "RESOLVE failed v4: rule id=$id domain=$target"
                continue
            fi
        fi
        if [[ "$proto" == "tcpudp" ]]; then
            echo "        tcp dport $lport dnat to $dest_ip:$rport" >> "$tmp"
            echo "        udp dport $lport dnat to $dest_ip:$rport" >> "$tmp"
        else
            echo "        tcp dport $lport dnat to $dest_ip:$rport" >> "$tmp"
        fi
    done < "$RULES_FILE"

    cat >> "$tmp" <<EOF
    }

    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
EOF

    while IFS='|' read -r id proto lport target rport atype note; do
        [[ "$id" =~ ^[0-9]+$ ]] || continue
        local dest_ip
        if [[ "$atype" == "ip" ]]; then
            dest_ip="$target"
        else
            dest_ip=$(resolve_domain_v4 "$target")
            [[ -z "$dest_ip" ]] && continue
        fi
        if [[ "$proto" == "tcpudp" ]]; then
            echo "        ip daddr $dest_ip tcp dport $rport masquerade" >> "$tmp"
            echo "        ip daddr $dest_ip udp dport $rport masquerade" >> "$tmp"
        else
            echo "        ip daddr $dest_ip tcp dport $rport masquerade" >> "$tmp"
        fi
    done < "$RULES_FILE"

    cat >> "$tmp" <<EOF
    }
}
EOF

    if [[ "$v6" == "yes" ]]; then
        cat >> "$tmp" <<EOF

table ip6 $TABLE6 {
    chain prerouting {
        type nat hook prerouting priority dstnat; policy accept;
EOF
        while IFS='|' read -r id proto lport target rport atype note; do
            [[ "$id" =~ ^[0-9]+$ ]] || continue
            [[ "$atype" == "ip" ]] && continue
            local dest_ip6
            dest_ip6=$(resolve_domain_v6 "$target")
            if [[ -z "$dest_ip6" ]]; then
                log "RESOLVE failed v6: rule id=$id domain=$target"
                continue
            fi
            if [[ "$proto" == "tcpudp" ]]; then
                echo "        tcp dport $lport dnat to [$dest_ip6]:$rport" >> "$tmp"
                echo "        udp dport $lport dnat to [$dest_ip6]:$rport" >> "$tmp"
            else
                echo "        tcp dport $lport dnat to [$dest_ip6]:$rport" >> "$tmp"
            fi
        done < "$RULES_FILE"

        cat >> "$tmp" <<EOF
    }

    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
EOF
        while IFS='|' read -r id proto lport target rport atype note; do
            [[ "$id" =~ ^[0-9]+$ ]] || continue
            [[ "$atype" == "ip" ]] && continue
            local dest_ip6
            dest_ip6=$(resolve_domain_v6 "$target")
            [[ -z "$dest_ip6" ]] && continue
            if [[ "$proto" == "tcpudp" ]]; then
                echo "        ip6 daddr $dest_ip6 tcp dport $rport masquerade" >> "$tmp"
                echo "        ip6 daddr $dest_ip6 udp dport $rport masquerade" >> "$tmp"
            else
                echo "        ip6 daddr $dest_ip6 tcp dport $rport masquerade" >> "$tmp"
            fi
        done < "$RULES_FILE"

        cat >> "$tmp" <<EOF
    }
}
EOF
    fi

    mv "$tmp" "$NFT_FILE"
    chmod 600 "$NFT_FILE"
}

# ============ 应用规则 ============
apply_rules() {
    load_settings

    sysctl -w net.ipv4.ip_forward=1 >/dev/null 2>&1
    if [[ "$IPV6_ENABLED" == "yes" ]]; then
        sysctl -w net.ipv6.conf.all.forwarding=1 >/dev/null 2>&1
    fi
    local sysctl_file="/etc/sysctl.d/99-nft-forward.conf"
    cat > "$sysctl_file" <<EOF
net.ipv4.ip_forward=1
EOF
    if [[ "$IPV6_ENABLED" == "yes" ]]; then
        echo "net.ipv6.conf.all.forwarding=1" >> "$sysctl_file"
    fi

    generate_nft "$IPV6_ENABLED"

    nft list table ip $TABLE4 >/dev/null 2>&1 && nft delete table ip $TABLE4 2>/dev/null
    if [[ "$IPV6_ENABLED" == "yes" ]]; then
        nft list table ip6 $TABLE6 >/dev/null 2>&1 && nft delete table ip6 $TABLE6 2>/dev/null
    fi

    if nft -f "$NFT_FILE" 2>/tmp/nft-err; then
        msg "nftables 规则已生效"
        log "APPLY ok"
    else
        err "应用失败:"
        cat /tmp/nft-err
        log "APPLY failed: $(cat /tmp/nft-err)"
        return 1
    fi
}

# ============ DDNS 更新 ============
ddns_update() {
    load_settings
    local need_reload=0
    local state_file="$CONF_DIR/.ddns_cache"
    touch "$state_file"

    while IFS='|' read -r id proto lport target rport atype note; do
        [[ "$id" =~ ^[0-9]+$ ]] || continue
        [[ "$atype" == "domain" ]] || continue
        local new_ip
        new_ip=$(resolve_domain_v4 "$target")
        if [[ -n "$new_ip" ]]; then
            local old_ip
            old_ip=$(grep "^$id:v4:" "$state_file" | cut -d: -f3)
            if [[ "$new_ip" != "$old_ip" ]]; then
                sed -i "/^$id:v4:/d" "$state_file"
                echo "$id:v4:$new_ip" >> "$state_file"
                need_reload=1
                log "DDNS rule=$id $target v4: $old_ip -> $new_ip"
            fi
        fi

        if [[ "$IPV6_ENABLED" == "yes" ]]; then
            local new_ip6
            new_ip6=$(resolve_domain_v6 "$target")
            if [[ -n "$new_ip6" ]]; then
                local old_ip6
                old_ip6=$(grep "^$id:v6:" "$state_file" | cut -d: -f3-)
                if [[ "$new_ip6" != "$old_ip6" ]]; then
                    sed -i "/^$id:v6:/d" "$state_file"
                    echo "$id:v6:$new_ip6" >> "$state_file"
                    need_reload=1
                    log "DDNS rule=$id $target v6: $old_ip6 -> $new_ip6"
                fi
            fi
        fi
    done < "$RULES_FILE"

    if [[ "$need_reload" == "1" ]]; then
        apply_rules
    fi
}

# ============ 设置子菜单 ============
toggle_ipv6() {
    load_settings
    echo ""
    info "当前 IPv6 转发状态: $IPV6_ENABLED"
    echo ""
    local target_state
    if [[ "$IPV6_ENABLED" == "yes" ]]; then
        target_state="no"
        echo "即将关闭 IPv6 转发"
    else
        target_state="yes"
        echo "即将开启 IPv6 转发"
    fi
    if ! confirm_yn "确认切换?"; then
        info "已取消"
        return
    fi
    IPV6_ENABLED="$target_state"
    save_settings
    msg "IPv6 已设置为: $IPV6_ENABLED"
    apply_rules
}

set_ddns_interval() {
    load_settings
    echo ""
    info "当前 DDNS 检查间隔: ${DDNS_INTERVAL_MIN} 分钟"
    echo ""
    local m
    read -rp "新间隔(分钟,1-1440, 输入 0 取消): " m
    if [[ "$m" == "0" ]] || [[ -z "$m" ]]; then
        info "已取消"
        return
    fi
    if ! [[ "$m" =~ ^[0-9]+$ ]] || [ "$m" -lt 1 ] || [ "$m" -gt 1440 ]; then
        err "无效输入"
        return
    fi
    echo ""
    info "即将把 DDNS 检查间隔改为 $m 分钟"
    if ! confirm_yn "确认修改?"; then
        info "已取消"
        return
    fi
    DDNS_INTERVAL_MIN="$m"
    save_settings
    sed -i "s|^OnUnitActiveSec=.*|OnUnitActiveSec=${m}min|" /etc/systemd/system/nft-forward-ddns.timer 2>/dev/null
    systemctl daemon-reload
    systemctl restart nft-forward-ddns.timer 2>/dev/null
    msg "DDNS 检查间隔已更新为 $m 分钟"
}

settings_menu() {
    while true; do
        load_settings
        clear
        hr
        hr_title "设置"
        hr
        echo "  当前 IPv6 转发:    $IPV6_ENABLED"
        echo "  当前 DDNS 间隔:    ${DDNS_INTERVAL_MIN} 分钟"
        hr_thin
        echo "  1) 切换 IPv6 开关"
        echo "  2) 修改 DDNS 检查间隔"
        echo "  0) 返回上级"
        hr_thin
        local c
        read -rp "选择: " c
        case "$c" in
            1) toggle_ipv6; pause ;;
            2) set_ddns_interval; pause ;;
            0) return ;;
            *) warn "无效选择"; sleep 1 ;;
        esac
    done
}

# ============ 状态 ============
show_status() {
    echo ""
    info "=== nft-forward 状态 ==="
    load_settings
    echo "IPv6 转发: $IPV6_ENABLED"
    echo "DDNS 间隔: ${DDNS_INTERVAL_MIN} 分钟"
    echo ""
    info "systemd 服务:"
    if systemctl is-enabled nft-forward.service >/dev/null 2>&1; then
        echo "  nft-forward.service: 已启用"
    else
        echo "  nft-forward.service: 未启用"
    fi
    if systemctl is-active nft-forward-ddns.timer 2>/dev/null | grep -q active; then
        echo "  nft-forward-ddns.timer: 运行中"
    else
        echo "  nft-forward-ddns.timer: 未运行"
    fi
    echo ""
    info "当前 nftables 表 ($TABLE4):"
    nft list table ip $TABLE4 2>/dev/null || echo "  (未加载)"
    echo ""
}

# ============ 在线更新 ============
REPO_URL="https://github.com/merlin-node/nft-forward/archive/refs/heads/main.zip"

self_update() {
    echo ""
    hr_title "在线更新 nft-forward" "$CYAN"
    echo ""
    echo "将从 GitHub 拉取最新版本并重新安装:"
    echo "  $REPO_URL"
    echo ""
    info "你的规则和设置不会被覆盖"
    echo ""
    if ! confirm_yn "确认更新?"; then
        info "已取消"
        return
    fi

    # 检查依赖
    if ! command -v wget >/dev/null 2>&1; then
        err "未安装 wget,正在安装..."
        apt-get install -y wget || { err "wget 安装失败"; return 1; }
    fi
    if ! command -v unzip >/dev/null 2>&1; then
        err "未安装 unzip,正在安装..."
        apt-get install -y unzip || { err "unzip 安装失败"; return 1; }
    fi

    local tmpdir
    tmpdir=$(mktemp -d)
    cd "$tmpdir" || { err "无法进入临时目录"; return 1; }

    msg "下载最新版本..."
    if ! wget -q --show-progress "$REPO_URL" -O update.zip; then
        err "下载失败,请检查网络"
        rm -rf "$tmpdir"
        return 1
    fi

    msg "解压..."
    if ! unzip -q update.zip; then
        err "解压失败"
        rm -rf "$tmpdir"
        return 1
    fi

    local pkgdir
    pkgdir=$(find "$tmpdir" -maxdepth 1 -type d -name "nft-forward-*" | head -1)
    if [[ -z "$pkgdir" ]] || [[ ! -f "$pkgdir/install.sh" ]]; then
        err "压缩包结构异常,找不到 install.sh"
        rm -rf "$tmpdir"
        return 1
    fi

    msg "运行安装脚本..."
    cd "$pkgdir"
    bash install.sh

    msg "清理临时文件..."
    rm -rf "$tmpdir"

    echo ""
    msg "更新完成,重新进入菜单..."
    sleep 2
    exec /usr/local/bin/nft-forward
}

# ============ 一键卸载 ============
self_uninstall() {
    echo ""
    hr_title "一键卸载 nft-forward" "$YELLOW"
    echo ""
    echo "将执行以下操作:"
    echo "  1. 停止并禁用 systemd 服务(开机自启、DDNS定时器)"
    echo "  2. 清除本脚本创建的 nftables 表"
    echo "  3. 删除主程序 /usr/local/bin/nft-forward 和短命令 zf"
    echo "  4. 删除自动生成的配置 /etc/nftables-forward.conf"
    echo "  5. 删除 IP 转发设置 /etc/sysctl.d/99-nft-forward.conf"
    echo ""
    warn "你现有的转发规则会全部失效!"
    echo ""
    if ! confirm_yn "确认卸载?"; then
        info "已取消"
        return
    fi

    echo ""
    local keep_conf="n"
    if confirm_yn "是否保留配置和日志? (规则文件 /etc/nft-forward 和日志)"; then
        keep_conf="y"
    fi

    echo ""
    msg "停止服务..."
    systemctl stop nft-forward-ddns.timer 2>/dev/null || true
    systemctl stop nft-forward-ddns.service 2>/dev/null || true
    systemctl stop nft-forward.service 2>/dev/null || true
    systemctl disable nft-forward-ddns.timer 2>/dev/null || true
    systemctl disable nft-forward.service 2>/dev/null || true

    msg "清除 nftables 表..."
    nft delete table ip $TABLE4 2>/dev/null || true
    nft delete table ip6 $TABLE6 2>/dev/null || true

    msg "删除文件..."
    rm -f /etc/systemd/system/nft-forward.service
    rm -f /etc/systemd/system/nft-forward-ddns.service
    rm -f /etc/systemd/system/nft-forward-ddns.timer
    rm -f /etc/logrotate.d/nft-forward
    rm -f /usr/local/bin/zf
    rm -f "$NFT_FILE"
    rm -f /etc/sysctl.d/99-nft-forward.conf
    systemctl daemon-reload

    if [[ "$keep_conf" != "y" ]]; then
        rm -rf "$CONF_DIR"
        rm -f "$LOG_FILE" "${LOG_FILE}".*
        msg "配置和日志已删除"
    else
        msg "已保留 $CONF_DIR 和 $LOG_FILE"
    fi

    # 最后删自己 (主程序)
    msg "删除主程序..."
    rm -f /usr/local/bin/nft-forward

    echo ""
    hr "$GREEN"
    echo -e "${GREEN}  卸载完成,再见!${NC}"
    hr "$GREEN"
    echo ""
    exit 0
}

# ============ 主菜单 ============
menu() {
    while true; do
        clear
        load_settings
        hr
        hr_title "nft-forward 中转管理"
        hr
        echo "  IPv6: $IPV6_ENABLED   DDNS间隔: ${DDNS_INTERVAL_MIN}分钟"
        hr_thin
        echo "  1) 查看规则"
        echo "  2) 添加规则"
        echo "  3) 删除规则"
        echo "  4) 重新应用规则"
        echo "  5) 立即更新 DDNS"
        echo "  6) 设置"
        echo "  7) 查看状态"
        echo "  8) 查看日志(最后20行)"
        echo "  9) 卸载本脚本"
        echo " 10) 在线更新脚本"
        echo "  0) 退出脚本"
        hr_thin
        local c
        read -rp "选择: " c
        case "$c" in
            1) list_rules; pause ;;
            2) add_rule; pause ;;
            3) del_rule; pause ;;
            4) apply_rules; pause ;;
            5) ddns_update; msg "DDNS 检查完成"; pause ;;
            6) settings_menu ;;
            7) show_status; pause ;;
            8) tail -20 "$LOG_FILE"; pause ;;
            9) self_uninstall ;;
            10) self_update ;;
            0) echo ""; msg "再见"; exit 0 ;;
            *) warn "无效选择"; sleep 1 ;;
        esac
    done
}

